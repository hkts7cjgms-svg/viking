# Skopiuj do agent/.env i uzupelnij. Plik .env jest w .gitignore i nigdy
# nie trafia do repozytorium.

# ─── WordPress: wydarzenia ────────────────────────────────────────────────
# Adres strony - koniecznie https, bo haslo idzie przez Basic auth.
KV_SITE_URL=https://kuchniavikinga.pl

# Login uzytkownika WordPressa z uprawnieniem "edytuj wpisy".
KV_USER=

# Haslo aplikacji z Uzytkownicy -> Profil -> Hasla aplikacji.
# To NIE jest zwykle haslo do panelu - da sie je cofnac jednym kliknieciem.
KV_APP_PASSWORD=

# ─── Panel klienta: odczyt jadlospisu ─────────────────────────────────────
KV_PANEL_URL=https://panel.kuchniavikinga.pl
KV_PANEL_USER=
KV_PANEL_PASSWORD=

# KV_HEADLESS=0 otwiera widoczne okno przegladarki - przydatne przy pierwszym
# uruchomieniu i gdy cos nie dziala.
# KV_HEADLESS=0

# ─── Archiwum jadlospisu ──────────────────────────────────────────────────
# Plik CSV, do ktorego dopisuja sie wszystkie pobrane dni. Otwiera sie wprost
# w Numbers i w Arkuszach Google. Nic z niego nie znika.
KV_ARCHIVE_CSV=~/Documents/kuchnia-vikinga/jadlospis.csv

# ─── Kalendarz: Apple albo Google ─────────────────────────────────────────
# apple (domyslnie, macOS) albo google.
KV_CALENDAR_TARGET=apple

# Nazwa kalendarza w Kalendarzu Apple. Zaloz go recznie przed pierwszym
# uruchomieniem: Kalendarz -> Plik -> Nowy kalendarz.
KV_APPLE_CALENDAR=Jadłospis

# Tytul wpisow (dziala dla obu kalendarzy).
KV_CALENDAR_TITLE=Jadłospis — Kuchnia Vikinga

# ─── Kalendarz Google (tylko przy KV_CALENDAR_TARGET=google) ──────────────
# Kalendarz docelowy: "primary" albo identyfikator kalendarza wspoldzielonego.
GOOGLE_CALENDAR_ID=primary

# Sposob 1: refresh token (dziala tez na zwyklym koncie gmail.com).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Sposob 2: konto uslugowe (kalendarz musi byc mu udostepniony do edycji).
# Zamiast trzech powyzszych wypelnij te dwa. Klucz w jednej linii, z \n.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n…\n-----END PRIVATE KEY-----\n"
# GOOGLE_SUBJECT=            # tylko Workspace, gdy dzialasz w czyimś imieniu
